# Terraform state and working directories
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
.terraform.lock.hcl
.terraform.tfstate.lock.info

# Sensitive variable files — NEVER commit real values
*.tfvars
*.tfvars.json
!*.tfvars.example

# Secrets and credentials
.env
*.pem
*.key
*.pfx
*.p12
*.crt

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI config
.terraformrc
terraform.rc

# Crash logs
crash.log
crash.*.log

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Graphify output (local analysis only)
graphify-out/
